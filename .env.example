# ---- Armazenamento ----
# Desenvolvimento local: arquivos em .data/ (não funciona na Vercel)
STORE=file
# Produção (Supabase). Use a chave "service_role" (secreta, só no servidor):
# STORE=supabase
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Acesso (obrigatório em produção) ----
# Senha única do app e segredo para assinar o cookie de sessão (use um texto longo e aleatório)
APP_PASSWORD=
SESSION_SECRET=

# ---- Rotina agendada (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>") ----
CRON_SECRET=

# ---- Alertas (todos opcionais; configure só os canais que for usar) ----
# Telegram: crie um bot no @BotFather, copie o token aqui e informe seu chat id em Configurações
TELEGRAM_BOT_TOKEN=
# E-mail por SMTP (ex.: Gmail com "senha de app")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Notificações push no navegador/celular: gere com `npm run vapid`
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
